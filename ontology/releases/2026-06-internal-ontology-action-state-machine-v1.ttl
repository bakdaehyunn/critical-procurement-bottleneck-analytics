dcai-release:2026-06-internal-ontology-action-state-machine-v1
  rdf:type owl:Ontology ;
  dcterms:title "Internal ontology action state machine v1 release" ;
  dcterms:description "Internal kinetic-layer state machine release for governed ontology action records. It adds controlled lifecycle states REQUESTED, VALIDATED, QUEUED, IN_REVIEW, APPROVED, REJECTED, and CLOSED; transition DTOs and validation; SHACL/provenance gates for action transition facts; idempotent and rollback-safe writes to managed action-audit graph state only; approved semanticActionReviewQueueByIncident and semanticActionTransitionHistoryByIncident read models; React detail UI review controls for queued, in-review, approved, rejected, and closed local action records; lifecycle transition history; focused tests; API DTO notes; and docs. It does not expose public endpoints, add authentication, implement AI governance, mutate source/canonical/reasoning/provenance/operations/production graphs from UI actions, add real external connectors, perform source-system writeback, commit, or push." ;
  dcterms:created "2026-06-14"^^xsd:date ;
  dcterms:requires dcai-release:2026-06-internal-ontology-action-request-notification-v1 ;

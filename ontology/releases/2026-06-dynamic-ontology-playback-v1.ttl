dcai-release:2026-06-dynamic-ontology-playback-v1
  rdf:type owl:Ontology ;
  dcterms:title "Dynamic ontology playback v1 release" ;
  dcterms:description "Internal local deterministic dynamic playback for the ontology-native AI data center semantic operations platform. This release adds controlled source-system replay steps, routes each step through existing source promotion and reasoning refresh boundaries, writes playback audit facts into the managed action-audit graph with SHACL/provenance validation and rollback, exposes approved read models for event timeline, graph state changes, reasoning/trust changes, and action lifecycle changes, and renders a compact React detail panel. It does not expose public endpoints, raw SPARQL, authentication, real external connectors, AI governance, commit, or push." ;
  dcterms:created "2026-06-15"^^xsd:date ;
  dcterms:requires dcai-release:2026-06-internal-ontology-action-state-machine-v1 ;

dcai-release:2026-06-internal-ontology-action-dispatch-simulation-v1
  rdf:type owl:Ontology ;
  dcterms:title "Internal ontology action dispatch simulation v1 release" ;
  dcterms:description "Internal simulated operations dispatch release for approved local ontology action transitions. It adds OntologyActionDispatch facts for simulated NOC, work-order, and validation-review queues; SHACL/provenance validation; approved semanticActionDispatchQueueByIncident read-model support; typed semantic-service envelopes and serialization; frontend selected-finding dispatch visibility; focused tests; and docs. This release writes only managed action-audit graph state and does not expose public endpoints, add authentication, mutate canonical/reasoning/provenance/operations/source graphs, add real external connectors, perform external writeback, implement AI governance, commit, or push." ;
  dcterms:created "2026-06-15"^^xsd:date ;
  dcterms:requires dcai-release:2026-06-internal-ontology-action-state-machine-v1 ;

dcai-release:2026-06-internal-ontology-action-audit-runner-v1
  rdf:type owl:Ontology ;
  dcterms:title "Internal ontology action audit runner v1 release" ;
  dcterms:description "Internal CLI/runtime release for audit-only governed ontology actions. It adds Kotlin DTOs, controlled local action request loading, precondition validation over managed canonical/provenance/reasoning graph facts, RDF action-audit/provenance records, SHACL/provenance gates, managed action-audit graph writes, idempotent reruns, rollback-safe action-audit writes, action audit inspection, focused tests, fixtures, and docs. This release does not expose public endpoints, add authentication, redesign UI, mutate canonical/reasoning/operations graphs from operator actions, add real external connectors, implement AI governance, commit, or push." ;
  dcterms:created "2026-06-13"^^xsd:date ;
  dcterms:requires dcai-release:2026-06-read-only-ontology-action-affordance-v1 ;

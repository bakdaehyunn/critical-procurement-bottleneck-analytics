dcai-release:2026-06-internal-ai-governance-proposal-v1
  rdf:type owl:Ontology ;
  dcterms:title "Internal AI governance proposal v1 release" ;
  dcterms:description "Internal AI governance proposal and human review release for ontology-native semantic operations. It adds AIProposalBatch, AIProposal, AIProposalValidationReport, and AIApprovalDecision ontology terms; SHACL and provenance gates; deterministic local proposal fixtures; rollback-safe managed ai-audit graph writes; idempotent proposal/review reruns; approved private semantic query IDs for AI proposal review queue and detail; a private internal AI proposal review endpoint; governed action-audit request creation for approved ACTION_RECOMMENDATION proposals; typed semantic-service envelopes and serialization; and frontend proposal review visibility. This release does not call external AI APIs, expose public endpoints, add authentication, mutate canonical/reasoning/provenance/source/operations graphs from AI proposals, perform source-system writeback, redesign UI, commit, or push." ;
  dcterms:created "2026-06-15"^^xsd:date ;
  dcterms:requires dcai-release:2026-06-internal-ontology-action-dispatch-simulation-v1 ;

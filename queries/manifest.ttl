@prefix dcai-query: <urn:dcai:query:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcai-query:manifest
  rdf:type dcai-query:QueryManifest ;
  dcterms:title "Ontology-native query manifest" ;
  dcterms:description "Approved read-only semantic query catalog for the ontology-native runtime. Entries with implementationStatus phase16-approved are loadable by semantic-service; service-owned Kotlin lifecycle and historical SPARQL/rule reference entries remain non-runtime catalog metadata." ;
  dcterms:created "2026-06-07"^^xsd:date ;
  dcai-query:hasEntry
    dcai-query:sourceToCanonicalPromotion,
    dcai-query:validFixtureConformance,
    dcai-query:invalidFixtureExpectation,
    dcai-query:provenanceLineageLookup,
    dcai-query:dependencyExposureReasoning,
    dcai-query:recoveryBlockerReasoning,
    dcai-query:restoreReadinessReasoning,
    dcai-query:impactTrustReasoning,
    dcai-query:blastRadiusReasoning,
    dcai-query:reasoningFindingLineageLookup,
    dcai-query:fixtureNamedGraphInventory,
    dcai-query:fixtureIncidentSummary,
    dcai-query:fixtureProvenanceSourceRecords,
    dcai-query:semanticFollowUpQueueList,
    dcai-query:semanticDashboardOverview,
    dcai-query:semanticFilterMetadata,
    dcai-query:semanticFollowUpDetail,
    dcai-query:semanticImpactSummary,
    dcai-query:semanticTopologyDependencies,
    dcai-query:semanticTrustFindingList,
    dcai-query:semanticStageBottlenecks,
    dcai-query:semanticAssetDelaySummary,
    dcai-query:semanticZoneDelaySummary,
    dcai-query:semanticSpareWaitSummary,
    dcai-query:semanticValidationSummary,
    dcai-query:semanticIncidentEvidence,
    dcai-query:semanticIncidentTimeline,
    dcai-query:semanticDependencyImpactByAsset,
    dcai-query:semanticBlastRadiusByAsset,
    dcai-query:semanticPromotionReviewQueue,
    dcai-query:semanticReasoningReviewQueue,
    dcai-query:semanticAvailableActionsByFinding,
    dcai-query:semanticActionAuditHistoryByRelease,
    dcai-query:semanticActionAuditHistoryByIncident,
    dcai-query:semanticActionAuditHistoryByTarget,
    dcai-query:semanticActionNotificationQueueByIncident,
    dcai-query:semanticActionReviewQueueByIncident,
    dcai-query:semanticActionTransitionHistoryByIncident,
    dcai-query:semanticActionDispatchQueueByIncident,
    dcai-query:semanticDynamicEventTimelineByIncident,
    dcai-query:semanticDynamicStateChangesByIncident,
    dcai-query:semanticDynamicReasoningChangesByIncident,
    dcai-query:semanticDynamicActionLifecycleByIncident,
    dcai-query:semanticAiProposalReviewQueue,
    dcai-query:semanticAiProposalDetailByIncident .

dcai-query:sourceToCanonicalPromotion
  rdf:type dcai-query:QueryEntry ;
  dcterms:title "Source-to-canonical graph promotion lifecycle reference" ;
  dcai-query:queryPath "queries/ingestion/promote_source_to_canonical.ru" ;
  dcai-query:queryMode "UPDATE" ;
  dcai-query:graphScope "source graph, canonical graph, provenance graph" ;
  dcai-query:implementationStatus "service-owned-kotlin" .

